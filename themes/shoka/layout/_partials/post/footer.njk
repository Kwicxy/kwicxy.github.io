<div class="meta">
  {%- if date(post.date) != date(post.updated) or time(post.date) != time(post.updated) %}
  <span class="item">
    <span class="icon">
      <i class="ic i-calendar-check"></i>
    </span>
    <span class="text">{{ __('post.edited') }}</span>
    <time title="{{ __('post.modified') + __('symbol.colon') + full_date(post.updated) }}" itemprop="dateModified" datetime="{{ moment(post.updated).format() }}">{{ date(post.updated) }}</time>
  </span>
  {%- endif %}

  {%- if theme.artalk and theme.artalk.pv %}
  <span class="item" title="{{ __('post.views') }}">
      <span class="icon">
        <i class="ic i-eye"></i>
      </span>
      <span class="text">{{ __('post.views') }}</span>
      <span class="artalk-pv-count" data-page-key="{{ _permapath(page.path) }}"></span>
      <span class="text">{{ __('symbols_count_time.view') }}</span>
  </span>
  {%- endif %}
</div>
